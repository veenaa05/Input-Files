# Check date relationships for Auto Approve records
date_check = invalid_lwd[
    [
        'Employee Code',
        'Date Of Joining',
        'Resignation Date',
        'Lwd As Per Notice Period',
        'Requested Relieving Date',
        'Agreed Lwd',
        'Approved Date'
    ]
].copy()

# Calculate useful date differences
date_check['LWD_vs_Resignation_Days'] = (
    date_check['Agreed Lwd'] - date_check['Resignation Date']
).dt.days

date_check['Approval_vs_LWD_Days'] = (
    date_check['Approved Date'].dt.normalize() -
    date_check['Agreed Lwd']
).dt.days

display(date_check.head(30))




///////////
print("Agreed LWD before Resignation Date:")
