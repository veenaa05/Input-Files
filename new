importance_df = global_importance.copy()

def get_original_feature(processed_name):

    # Remove transformer prefixes
    name = processed_name

    if name.startswith("numeric__"):
        return name.replace("numeric__", "", 1)

    if name.startswith("categorical__"):
        name = name.replace("categorical__", "", 1)

        # Match against original categorical columns
        for col in categorical_features:
            if name.startswith(col + "_"):
                return col

        return name

    return name


importance_df["Original_Feature"] = (
    importance_df["Processed_Feature"]
    .apply(get_original_feature)
)


# ------------------------------------------------------------
# Aggregate all encoded columns belonging to the same feature
# ------------------------------------------------------------

business_importance = (
    importance_df
    .groupby("Original_Feature", as_index=False)
    ["Mean_Reconstruction_Error"]
    .sum()
    .sort_values(
        "Mean_Reconstruction_Error",
        ascending=False
    )
    .reset_index(drop=True)
)


# ------------------------------------------------------------
# Add percentage contribution
# ------------------------------------------------------------

total_error = business_importance[
    "Mean_Reconstruction_Error"
].sum()

business_importance["Importance_%"] = (
    business_importance["Mean_Reconstruction_Error"]
    / total_error
    * 100
)


