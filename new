# Compare Agreed LWD from Resignation Report
# with Last Working Date from Employee Master

# Keep only the required columns
master_exit = employee_master[
    ['Employee Code', 'Resignation Date', 'Last Working Date']
].copy()

resignation_exit = valid_resignations[
    ['Employee Code', 'Agreed Lwd', 'Resignation Date']
].copy()

# Convert dates
for col in ['Resignation Date', 'Last Working Date']:
    master_exit[col] = pd.to_datetime(master_exit[col], errors='coerce')

resignation_exit['Agreed Lwd'] = pd.to_datetime(
    resignation_exit['Agreed Lwd'], errors='coerce'
)

# Clean employee codes
master_exit['Employee Code'] = master_exit['Employee Code'].astype(str).str.strip()
resignation_exit['Employee Code'] = resignation_exit['Employee Code'].astype(str).str.strip()

# Merge
exit_check = resignation_exit.merge(
    master_exit,
    on='Employee Code',
    how='inner',
    suffixes=('_resignation_report', '_employee_master')
)

# Compare Agreed LWD with Employee Master LWD
exit_check['LWD_match'] = (
    exit_check['Agreed Lwd'].dt.normalize()
    == exit_check['Last Working Date'].dt.normalize()
)

print("Records matched between both reports:", len(exit_check))
print("Agreed LWD = Employee Master LWD:", exit_check['LWD_match'].sum())
print("Agreed LWD != Employee Master LWD:",
      (~exit_check['LWD_match']).sum())

print("\nMissing Employee Master LWD:",
      exit_check['Last Working Date'].isna().sum())

print("\nLWD match %:",
      round(exit_check['LWD_match'].mean() * 100, 2), "%")
