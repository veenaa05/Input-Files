from prophet import Prophet
from sklearn.metrics import mean_absolute_error, mean_squared_error
import numpy as np

# Test different historical windows
windows = [24, 36, 60, 120, len(train)]
changepoints = [0.05, 0.1, 0.2, 0.5]

results = []

for window in windows:

    train_window = train.tail(window)

    for cps in changepoints:

        m = Prophet(
            yearly_seasonality=True,
            weekly_seasonality=False,
            daily_seasonality=False,
            changepoint_prior_scale=cps
        )

        m.fit(train_window)

        future = m.make_future_dataframe(
            periods=test_months,
            freq='ME'
        )

        fc = m.predict(future)

        pred = fc[
            fc['ds'].isin(test['ds'])
        ][['ds', 'yhat']]

        comparison = test[['ds', 'y']].merge(
            pred,
            on='ds'
        )

        mae = mean_absolute_error(
            comparison['y'],
            comparison['yhat']
        )

        rmse = np.sqrt(
            mean_squared_error(
                comparison['y'],
                comparison['yhat']
            )
        )

        mape = np.mean(
            np.abs(
                (comparison['y'] - comparison['yhat'])
                / comparison['y']
            )
        ) * 100

        results.append({
            'Window': window,
            'Changepoint': cps,
            'MAE': mae,
            'RMSE': rmse,
            'MAPE': mape
        })

