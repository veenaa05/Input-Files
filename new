# Validate Agreed LWD only where Employee Master LWD is available

lwd_available = exit_check[
    exit_check['Last Working Date'].notna()
].copy()

print("Records with Employee Master LWD available:",
      len(lwd_available))

print("Agreed LWD = Employee Master LWD:",
      lwd_available['LWD_match'].sum())

print("Agreed LWD != Employee Master LWD:",
      (~lwd_available['LWD_match']).sum())

print(
    "LWD match % among available LWD:",
    round(lwd_available['LWD_match'].mean() * 100, 2),
    "%"
)
