# Check approved/rejected/revoked records separately

status_summary = (
    resignation_report.groupby('Resignation Status')
    .agg(
        records=('Employee Code', 'count'),
        agreed_lwd=('Agreed Lwd', 'count'),
        approved_date=('Approved Date', 'count')
    )
    .sort_values('records', ascending=False)
)

display(status_summary)
