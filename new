# Keep only approved resignation records

approved_statuses = [
    'Auto Approve',
    'Approve by Skip Level Manager',
    'Approve By Site Managers',
    'Approve by Reporting Manager',
    'Approve by Reporting Partner',
    'Approve By Operation Manager',
    'Approve by RM RP Sys Admin'
]

valid_resignations = resignation_report[
    resignation_report['Resignation Status'].isin(approved_statuses)
].copy()

print("Approved resignation records:", len(valid_resignations))

print("Unique employees:", valid_resignations['Employee Code'].nunique())






////////////

# If an employee has multiple approved resignation records,
# keep the latest approved record

valid_resignations = (
    valid_resignations
    .sort_values('Approved Date')
    .drop_duplicates('Employee Code', keep='last')
)

print("After removing duplicate resignation records:")
print("Records:", len(valid_resignations))
print("Unique employees:", valid_resignations['Employee Code'].nunique())

display(
    valid_resignations[
        ['Employee Code',
         'Resignation Date',
         'Agreed Lwd',
         'Resignation Status',
         'Approved Date']
    ].head(20)
)
///////
# Monthly actual exits based on Agreed LWD

valid_resignations['Exit Month'] = (
    valid_resignations['Agreed Lwd']
    .dt.to_period('M')
)

monthly_exits = (
    valid_resignations
    .dropna(subset=['Agreed Lwd'])
    .groupby('Exit Month')
    .size()
    .reset_index(name='resigned_employees')
)

print(monthly_exits)
