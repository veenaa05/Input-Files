print("\nAgreed LWD after Resignation Date:")
print((date_check['LWD_vs_Resignation_Days'] > 0).sum())

print("\nAgreed LWD same as Resignation Date:")
print((date_check['LWD_vs_Resignation_Days'] == 0).sum())

print("\nLWD date range:")
