# Employee to explain
employee_id = 331498

# Find employee index in the original dataset
employee_idx = burnout_model_data.index[
    burnout_model_data["EMP_CODE_STD"].astype(str)
    == str(employee_id)
]

if len(employee_idx) == 0:
    print(f"Employee {employee_id} not found.")

else:
    idx = employee_idx[0]

    # Feature-level reconstruction errors for this employee
    employee_errors = pd.DataFrame({
        "Processed_Feature": processed_feature_names,
        "Reconstruction_Error": reconstruction_errors[idx]
    })

    # Map processed feature -> original business feature
    employee_errors["Original_Feature"] = (
        employee_errors["Processed_Feature"]
        .apply(get_original_feature)
    )

    # Aggregate encoded categorical features
    employee_business_errors = (
        employee_errors
        .groupby("Original_Feature", as_index=False)
        ["Reconstruction_Error"]
        .sum()
        .sort_values(
            "Reconstruction_Error",
            ascending=False
        )
        .reset_index(drop=True)
    )

    print("=" * 65)
    print(f"INDIVIDUAL BURNOUT EXPLANATION - EMPLOYEE {employee_id}")
    print("=" * 65)

    print(
        employee_business_errors
        .head(15)
        .to_string(index=False)
    )

    print("\n" + "=" * 65)
    print("EMPLOYEE DETAILS")
    print("=" * 65)

    print(
        burnout_model_data[
            burnout_model_data["EMP_CODE_STD"].astype(str)
            == str(employee_id)
        ].T
    )
