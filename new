# Create monthly historical headcount

start_month = employees['Actual Join Date'].min().to_period('M')
end_month = pd.Timestamp.today().to_period('M')

months = pd.period_range(
    start=start_month,
    end=end_month,
    freq='M'
)

monthly_headcount = []

for month in months:

    month_end = month.to_timestamp('M')

    joined = (
        employees['Actual Join Date'] <= month_end
    )

    not_exited = (
        employees['Agreed Lwd'].isna() |
        (employees['Agreed Lwd'] > month_end)
    )

    headcount = (joined & not_exited).sum()

    monthly_headcount.append({
        'Month': month_end,
        'Headcount': int(headcount)
    })

monthly_headcount = pd.DataFrame(monthly_headcount)

display(monthly_headcount.tail(15))
