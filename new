# Check date ranges and resignation/notice details

print("Actual Join Date range:")
print("Min:", employee_master['Actual Join Date'].min())
print("Max:", employee_master['Actual Join Date'].max())

print("\nResignation Date range:")
print("Min:", employee_master['Resignation Date'].min())
print("Max:", employee_master['Resignation Date'].max())

print("\nLast Working Date range:")
print("Min:", employee_master['Last Working Date'].min())
print("Max:", employee_master['Last Working Date'].max())

print("\nStatus vs available dates:")
display(
    employee_master.groupby('Employee Status')[
        ['Actual Join Date', 'Resignation Date', 'Last Working Date']
    ].agg(['count', 'min', 'max'])



