# Check employee-code overlap and duplicates

employee_master_codes = (
    employee_master['Employee Code']
    .astype(str)
    .str.strip()
)

resignation_codes = (
    resignation_report['Employee Code']
    .astype(str)
    .str.strip()
)

print("Employee Master unique employees:",
      employee_master_codes.nunique())

print("Resignation Report unique employees:",
      resignation_codes.nunique())

print("\nEmployee codes appearing in BOTH reports:",
      len(set(employee_master_codes) & set(resignation_codes)))

print("\nDuplicate employee codes in Resignation Report:",
      resignation_codes.duplicated().sum())

print("\nDuplicate employee codes in Employee Master:",
      employee_master_codes.duplicated().sum())
