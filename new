# Clean invalid/sentinel dates

employee_master['Actual Join Date'] = pd.to_datetime(
    employee_master['Actual Join Date'], errors='coerce'
)

employee_master['Resignation Date'] = pd.to_datetime(
    employee_master['Resignation Date'], errors='coerce'
)

employee_master['Last Working Date'] = pd.to_datetime(
    employee_master['Last Working Date'], errors='coerce'
)

# Treat 1930-12-31 as invalid/missing
employee_master.loc[
    employee_master['Last Working Date'] == pd.Timestamp('1930-12-31'),
    'Last Working Date'
] = pd.NaT

print("Valid resignation dates:",
      employee_master['Resignation Date'].notna().sum())

print("Valid last working dates:",
      employee_master['Last Working Date'].notna().sum())

print("\nStatus:")
print(employee_master['Employee Status'].value_counts())
