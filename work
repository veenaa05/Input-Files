def clean_emp_code(series):
    return (
        series.astype(str)
        .str.strip()
        .str.replace(r"\.0$", "", regex=True)
        .replace({"nan": pd.NA, "None": pd.NA, "": pd.NA})
    )


# Create clean employee-code columns
master_codes = clean_emp_code(employee_master_new["Employee Code"])
leave_codes = clean_emp_code(leave_application["Employee Code"])
balance_codes = clean_emp_code(monthly_leave_balance["Employee Code"])
ot_codes = clean_emp_code(overtime_1["EMP CODE"])
ot_daily_codes = clean_emp_code(overtime_2["EMP CODE"])


# Unique codes
master_set = set(master_codes.dropna().unique())
leave_set = set(leave_codes.dropna().unique())
balance_set = set(balance_codes.dropna().unique())
ot_set = set(ot_codes.dropna().unique())
ot_daily_set = set(ot_daily_codes.dropna().unique())


print("========== UNIQUE EMPLOYEE CODES ==========")
print("Employee Master :", len(master_set))
print("Leave Application:", len(leave_set))
print("Leave Balance   :", len(balance_set))
print("OT Summary      :", len(ot_set))
print("OT Daily        :", len(ot_daily_set))


print("\n========== MATCHING WITH EMPLOYEE MASTER ==========")

print(
    "Leave Application:",
    len(master_set & leave_set),
    "employees matched"
)

print(
    "Monthly Leave Balance:",
    len(master_set & balance_set),
    "employees matched"
)

print(
    "OT Summary:",
    len(master_set & ot_set),
    "employees matched"
)

print(
    "OT Daily:",
    len(master_set & ot_daily_set),
    "employees matched"
)


print("\n========== COVERAGE % ==========")

print(
    "Leave coverage:",
    round(len(master_set & leave_set) / len(master_set) * 100, 2),
    "%"
)

print(
    "Leave Balance coverage:",
    round(len(master_set & balance_set) / len(master_set) * 100, 2),
    "%"
)

print(
    "OT coverage:",
    round(len(master_set & ot_set) / len(master_set) * 100, 2),
    "%"
)
