
# ============================================
# CLEAN EMPLOYEE MASTER DUPLICATES
# ============================================

master = employee_master_new.copy()

# Convert dates
master["Effective Start Date"] = pd.to_datetime(
    master["Effective Start Date"],
    errors="coerce"
)

# Priority for current employee record
status_priority = {
    "Live": 1,
    "On-Notice": 2
}

master["_status_priority"] = (
    master["Employee Status"]
    .map(status_priority)
    .fillna(3)
)

# Sort:
# 1. Employee Code
# 2. Prefer Live
# 3. Latest Effective Start Date
master = master.sort_values(
    ["EMP_CODE_STD", "_status_priority", "Effective Start Date"],
    ascending=[True, True, False]
)

# Keep one record per employee
master_clean = (
    master
    .drop_duplicates(
        subset=["EMP_CODE_STD"],
        keep="first"
    )
    .drop(columns=["_status_priority"])
    .copy()
)

print("Original master:", employee_master_new.shape)
print("Clean master:", master_clean.shape)

print(
    "Unique employee codes:",
    master_clean["EMP_CODE_STD"].nunique()
)

print(
    "Remaining duplicate employee codes:",
    master_clean["EMP_CODE_STD"].duplicated().sum()
)
