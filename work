
# ============================================
# FIX DUPLICATE OT EMPLOYEE RECORDS
# ============================================

print("OT rows before:", len(ot_features))
print("OT unique employees before:", ot_features["EMP_CODE_STD"].nunique())

# Since duplicate rows are identical, keep one record per employee
ot_features_clean = (
    ot_features
    .drop_duplicates(subset=["EMP_CODE_STD"], keep="first")
    .copy()
)

print("\nOT rows after:", len(ot_features_clean))
print(
    "OT unique employees after:",
    ot_features_clean["EMP_CODE_STD"].nunique()
)


# ============================================
# REBUILD BURNOUT DATASET
# ============================================

burnout_data = master_features.merge(
    ot_features_clean,
    on="EMP_CODE_STD",
    how="left",
    validate="one_to_one"
)

burnout_data = burnout_data.merge(
    leave_features,
    on="EMP_CODE_STD",
    how="left",
    validate="one_to_one"
)


# Fill missing activity with zero
burnout_data[ot_cols] = burnout_data[ot_cols].fillna(0)
burnout_data[leave_cols] = burnout_data[leave_cols].fillna(0)


print("\n============================================")
print("FINAL MERGED DATASET CHECK")
print("============================================")

print("Rows:", len(burnout_data))
print("Unique employees:", burnout_data["EMP_CODE_STD"].nunique())
print(
    "Duplicate employee codes:",
    burnout_data["EMP_CODE_STD"].duplicated().sum()
)

print("Columns:", burnout_data.shape[1])
