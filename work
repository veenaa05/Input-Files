    # Leave behaviour
    "Leave_Total_Days",
    "Leave_Applications",
    "Leave_Avg_Days",
    "Leave_Max_Days",
    "Leave_Pending_Applications",

    # Employee experience
    "Tenure_Years"
]

print("Number of burnout model features:",
      len(burnout_model_features))

print("\nFeatures:")
for i, col in enumerate(burnout_model_features, 1):
