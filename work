# Check whether numeric conversion makes the codes match

master_num = pd.to_numeric(
    employee_master_new["Employee Code"],
    errors="coerce"
)

for name, col in {
    "Leave Application": "Employee Code",
    "Leave Balance": "Employee Code",
}.items():

    if name == "Leave Application":
        other_num = pd.to_numeric(
            leave_application[col],
            errors="coerce"
        )
    else:
        other_num = pd.to_numeric(
            monthly_leave_balance[col],
            errors="coerce"
        )

    print(
        name,
        "numeric matches:",
        master_num.isin(other_num).sum()
    )


